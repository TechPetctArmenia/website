---
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const GOOGLE_MAP = 'https://www.google.com/maps/d/u/0/embed?mid=1aNwMG3Qi1NxMobn1gqMiCOnJ5PWDO3wn&z=16';
const YANDEX_MAP = 'https://yandex.com/map-widget/v1/?text=Halabyan%2038%2F7%2C%20Yerevan&z=16';

const ui = {
  hy: { eyebrow: 'Տեղադրություն', title: 'Գտեք մեզ քարտեզի վրա', google: 'Google Քարտեզ', yandex: 'Yandex Քարտեզ' },
  en: { eyebrow: 'Location', title: 'Find us on the map', google: 'Google Maps', yandex: 'Yandex Maps' },
  ru: { eyebrow: 'Расположение', title: 'Найдите нас на карте', google: 'Google Карты', yandex: 'Яндекс Карты' },
}[lang];
---

<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{ui.eyebrow}</span>
      <h2>{ui.title}</h2>
    </div>
    <div class="dual-map reveal">
      <div class="map-panel">
        <div class="map-label">Google Maps</div>
        <iframe src={GOOGLE_MAP} title={ui.google} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <div class="map-panel">
        <div class="map-label">Yandex Maps</div>
        <iframe src={YANDEX_MAP} title={ui.yandex} loading="lazy"></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .dual-map {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .map-panel {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .map-label {
    padding: 12px 18px;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    font: 700 0.9375rem var(--font-head);
    color: var(--ink);
  }
  .map-panel iframe {
    display: block;
    width: 100%;
    height: 380px;
    border: 0;
  }
  @media (max-width: 900px) {
    .dual-map {
      grid-template-columns: minmax(0, 1fr);
    }
    .map-panel iframe {
      height: 320px;
    }
  }
</style>
