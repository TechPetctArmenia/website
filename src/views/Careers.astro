---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ContactForm from '../components/ContactForm.astro';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
---
<Base lang={lang} route="/careers" title={t(lang, 'careers.title')}>
  <PageHead title={t(lang, 'careers.title')} eyebrow={t(lang, 'about.eyebrow')} />
  <section class="section">
    <div class="container narrow">
      <div class="empty">
        <h2 style="font-size:1.5rem;margin-bottom:10px">{t(lang, 'careers.none')}</h2>
        <p style="margin:0">{t(lang, 'careers.lead')}</p>
      </div>
      <ContactForm lang={lang} topic="job" />
    </div>
  </section>
</Base>
